# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for Groq AI API calls.
# Users configure this via the Secrets panel in the AI Studio UI.
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Token de acceso personal (PAT) de GitHub para persistencia en el repositorio theworldoftirian/dragopedia.
GITHUB_TOKEN=""
GITHUB_BRANCH="main"

# Image Generation API Keys (Optional - for high-tier DM image generation)
OPENAI_API_KEY=""
TOGETHER_API_KEY=""
STABILITY_API_KEY=""
HF_TOKEN=""

# Discord Bot & Discord Activities Integration
# DISCORD_BOT_TOKEN: Token del bot creado en Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=""
# DISCORD_CLIENT_ID: ID de la aplicación de Discord para registrar comandos slash y Activities
DISCORD_CLIENT_ID=""
# DISCORD_GUILD_ID: (Opcional) ID de tu servidor de Discord para registrar comandos instantáneamente sin esperar cache global
DISCORD_GUILD_ID=""
